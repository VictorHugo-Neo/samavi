---
import "../styles/global.css";
const { title } = Astro.props;
---

<html lang="pt-BR" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} | Samavi Móveis e Decoração</title>
    </head>
    <body class="bg-gray-50 text-gray-900 font-sans antialiased flex flex-col min-h-screen">
        
        <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm transition-all duration-300">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center h-20">
                
                <a href="/" class="flex items-center transform transition-transform hover:scale-105" aria-label="Página Inicial Samavi">
                    <img 
                        src="/logoHeaderVermelho.svg" 
                        alt="Samavi Comercial" 
                        class="h-10 sm:h-12 w-auto" 
                    />
                </a>                
                
                <button id="mobile-menu-btn" class="md:hidden text-gray-700 hover:text-red-700 focus:outline-none p-2 bg-gray-50 rounded-lg transition-colors" aria-label="Abrir menu">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path id="icon-bars" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        <path id="icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

                <nav class="hidden md:flex items-center gap-8 font-medium">
                    <a 
                        href="/" 
                        class={`transition-colors ${Astro.url.pathname === '/' ? 'text-red-700 font-bold border-b-2 border-red-700 pb-1' : 'text-gray-700 hover:text-red-700'}`}
                    >
                        Início
                    </a>
                    <a 
                        href="/history" 
                        class={`transition-colors ${Astro.url.pathname.startsWith('/history') ? 'text-red-700 font-bold border-b-2 border-red-700 pb-1' : 'text-gray-700 hover:text-red-700'}`}
                    >
                        Eventos
                    </a>
                    <a 
                        href="/about" 
                        class={`transition-colors ${Astro.url.pathname.startsWith('/about') ? 'text-red-700 font-bold border-b-2 border-red-700 pb-1' : 'text-gray-700 hover:text-red-700'}`}
                    >
                        Sobre
                    </a>
                    
                    <a 
                        href="https://wa.me/5533988774411?text=Ol%C3%A1!%20Estou%20no%20site%20da%20Samavi%20e%20preciso%20de%20ajuda."
                        target="_blank"
                        rel="noopener noreferrer"
                        class="ml-4 inline-flex items-center gap-2 bg-red-700 hover:bg-red-800 text-white font-bold px-5 py-2.5 rounded-xl transition-all hover:-translate-y-0.5 shadow-md"
                    >
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
                        Fale Conosco
                    </a>
                </nav>
            </div>

            <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-white shadow-xl border-t border-gray-100">
                <nav class="flex flex-col px-6 py-4 font-medium text-lg">
                    <a 
                        href="/" 
                        class={`block py-4 border-b border-gray-100 ${Astro.url.pathname === '/' ? 'text-red-700 font-bold bg-red-50/50 -mx-6 px-6' : 'text-gray-800 hover:text-red-700'}`}
                    >
                        Início
                    </a>
                    <a 
                        href="/history" 
                        class={`block py-4 border-b border-gray-100 ${Astro.url.pathname.startsWith('/history') ? 'text-red-700 font-bold bg-red-50/50 -mx-6 px-6' : 'text-gray-800 hover:text-red-700'}`}
                    >
                        Eventos
                    </a>
                    <a 
                        href="/about" 
                        class={`block py-4 border-b border-gray-100 ${Astro.url.pathname.startsWith('/about') ? 'text-red-700 font-bold bg-red-50/50 -mx-6 px-6' : 'text-gray-800 hover:text-red-700'}`}
                    >
                        Sobre a Samavi
                    </a>
                    <a 
                        href="https://wa.me/5533988774411" 
                        target="_blank"
                        class="mt-6 flex justify-center items-center gap-2 bg-red-700 text-white py-4 rounded-xl font-bold shadow-md"
                    >
                        Atendimento via WhatsApp
                    </a>
                </nav>
            </div>
        </header>

        <main class="grow">
            <slot />
        </main>

        <footer class="bg-gray-900 text-gray-300 pt-20 pb-10 border-t-4 border-red-700">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
                
                <div class="md:col-span-4 lg:col-span-4">
                    <img 
                        src="/FooterLogo.svg" 
                        alt="Samavi Comercial" 
                        class="h-16 w-auto mb-6" 
                        onerror="this.onerror=null; this.src='/logoHeaderVermelho.svg'; this.classList.add('brightness-0', 'invert');"
                    />
                    <p class="text-sm text-gray-400 mb-6 leading-relaxed pr-4">
                        A sua casa merece o melhor. Móveis de qualidade, decoração e um atendimento dedicado para transformar o seu espaço no lar dos seus sonhos.
                    </p>
                    <div class="flex gap-4">
                        <a href="https://instagram.com/samavicomercial" target="_blank" class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-red-700 hover:text-white transition-colors" aria-label="Instagram">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                        </a>
                        <a href="#" class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-red-700 hover:text-white transition-colors" aria-label="Facebook">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
                        </a>
                    </div>
                </div>

                <div class="md:col-span-3 lg:col-span-2 lg:col-start-6">
                    <h4 class="font-bold text-white text-lg mb-6">Navegação</h4>
                    <ul class="space-y-3">
                        <li><a href="/" class="text-sm text-gray-400 hover:text-white transition-colors">Página Inicial</a></li>
                        <li><a href="/history" class="text-sm text-gray-400 hover:text-white transition-colors">Nossos Eventos</a></li>
                        <li><a href="/about" class="text-sm text-gray-400 hover:text-white transition-colors">Sobre Nós</a></li>
                        <li><a href="#" class="text-sm text-gray-400 hover:text-white transition-colors">Termos de Serviço</a></li>
                    </ul>
                </div>

                <div class="md:col-span-5 lg:col-span-4">
                    <h4 class="font-bold text-white text-lg mb-6">Atendimento e Localização</h4>
                    <ul class="space-y-4">
                        <li class="flex items-start gap-3">
                            <svg class="w-5 h-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            <div>
                                <p class="text-sm text-gray-300">Rua Dom Serafim, 16 - Centro</p>
                                <p class="text-sm text-gray-400">Araçuaí - MG</p>
                            </div>
                        </li>
                        <li class="flex items-center gap-3">
                            <svg class="w-5 h-5 text-red-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                            <p class="text-sm text-gray-300">(33) 98877-4411 <span class="text-gray-500 text-xs ml-1">(WhatsApp)</span></p>
                        </li>
                        <li class="flex items-center gap-3">
                            <svg class="w-5 h-5 text-red-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <div class="text-sm text-gray-300">
                                <p>Seg-Sex: 08:00 às 18:00</p>
                                <p class="text-gray-400">Sábado: 08:00 às 13:00</p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="border-t border-gray-800 py-6 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
                    <p>&copy; {new Date().getFullYear()} Samavi Comercial. Todos os direitos reservados.</p>
                    <p class="text-xs">Desenvolvido com excelência.</p>
                </div>
            </div>
        </footer>

        <a 
            href="https://wa.me/5533988774411?text=Ol%C3%A1!%20Vim%20pelo%20site%20e%20gostaria%20de%20atendimento." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="fixed bottom-6 right-6 z-50 bg-[#25D366] hover:bg-[#128C7E] text-white p-4 rounded-full shadow-[0_4px_20px_rgb(37,211,102,0.4)] transition-all duration-300 hover:scale-110 hover:-translate-y-1 group"
            aria-label="Fale conosco no WhatsApp"
        >
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
            </svg>
            <span class="absolute right-full mr-4 top-1/2 -translate-y-1/2 px-3 py-1.5 bg-gray-900 text-white text-xs font-bold rounded-lg opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity whitespace-nowrap">
                Falar com vendedor
            </span>
        </a>

        <script>
            const btn = document.getElementById('mobile-menu-btn');
            const menu = document.getElementById('mobile-menu');
            const iconBars = document.getElementById('icon-bars');
            const iconClose = document.getElementById('icon-close');

            if (btn && menu && iconBars && iconClose) {
                btn.addEventListener('click', () => {
                    menu.classList.toggle('hidden');
                    iconBars.classList.toggle('hidden');
                    iconClose.classList.toggle('hidden');
                });
            }
        </script>
    </body>
</html>