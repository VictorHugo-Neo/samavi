                    <div class="flex items-center gap-3">
                        <div class="bg-red-100 p-2 rounded-full">
                            <svg class="w-6 h-6 text-red-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <div>
                            <p class="text-sm font-extrabold text-gray-800">Pronta Entrega</p>
                            <p class="text-xs text-gray-500 font-medium">Consulte condições</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>