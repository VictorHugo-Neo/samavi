                        class="group relative w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-red-700 hover:bg-red-800 text-white font-bold text-lg py-4 px-8 rounded-xl shadow-[0_8px_30px_rgb(185,28,28,0.2)] hover:shadow-[0_8px_30px_rgb(185,28,28,0.4)] transition-all duration-300 hover:-translate-y-1"
