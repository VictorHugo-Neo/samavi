---
const avaliacoes = [
  {
    nome: "Maria Aparecida",
    texto: "Excelente atendimento! O sofá chegou antes do prazo e é super confortável. A equipa de montagem foi muito cuidadosa. Recomendo muito a Samavi.",
    estrelas: 5
  },
  {
    nome: "João Pedro Silva",
    texto: "Fiquei impressionado com a qualidade dos móveis. Os preços são justos e o atendimento pelo WhatsApp foi super rápido para tirar as minhas dúvidas.",
    estrelas: 5
  },
  {
    nome: "Ana Clara",
    texto: "Comprei a minha mesa de jantar e é lindíssima! Transformou completamente a minha sala. Parabéns pela qualidade e pelo respeito ao cliente.",
    estrelas: 5
  }
];
---

<section class="py-24 bg-white relative overflow-hidden">
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-72 h-72 rounded-full bg-red-50 opacity-50 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-72 h-72 rounded-full bg-gray-50 opacity-50 blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl md:text-4xl font-extrabold text-red-900 mb-4 tracking-tight">
                A confiança de quem já comprou
            </h2>
            <p class="text-lg text-gray-600">
                Fazer parte da história das famílias de Araçuaí e região é o nosso maior orgulho. Veja o que dizem os nossos clientes.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
            {avaliacoes.map((av) => (
                <div class="bg-gray-50/50 backdrop-blur-sm rounded-2xl p-8 border border-gray-100 shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-[0_4px_20px_rgb(0,0,0,0.08)] transition-all duration-300 relative group">
                    <svg class="absolute top-6 right-6 w-8 h-8 text-gray-200 group-hover:text-red-100 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                    </svg>

                    <div class="flex gap-1 mb-4 text-yellow-400">
                        {[...Array(av.estrelas)].map(() => (
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        ))}
                    </div>
                    
                    <p class="text-gray-700 mb-6 italic leading-relaxed relative z-10">
                        "{av.texto}"
                    </p>
                    
                    <div class="font-bold text-gray-900 border-t border-gray-200 pt-4">
                        {av.nome}
                    </div>
                </div>
            ))}
        </div>

        <div class="flex flex-col lg:flex-row justify-between items-center gap-8 bg-gray-900 rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">
            <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,var(--tw-gradient-stops))] from-white via-transparent to-transparent"></div>
            
            <div class="relative z-10 text-center lg:text-left w-full lg:w-auto flex-1">
                <h3 class="text-2xl font-bold text-white mb-2">Já é nosso cliente?</h3>
                <p class="text-gray-400">A sua opinião é fundamental para continuarmos a evoluir.</p>
            </div>
            
            <div class="relative z-10 flex flex-col sm:flex-row gap-4 w-full lg:w-auto">
                <a 
                    href="https://instagram.com/samavicomercial" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="w-full sm:w-auto inline-flex justify-center items-center gap-2 bg-transparent border-2 border-gray-700 hover:border-gray-500 text-white font-semibold py-3 px-6 rounded-xl transition-all whitespace-nowrap"
                >
                    <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                    Seguir Instagram
                </a>
                
                <a 
                    href="https://wa.me/5533988774411?text=Ol%C3%A1!%20Li%20a%20hist%C3%B3ria%20da%20Samavi%20no%20site%20e%20gostaria%20de%20falar%20com%20voc%C3%AAs." 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="w-full sm:w-auto inline-flex justify-center items-center gap-2 bg-white hover:bg-gray-100 text-gray-900 font-bold py-3 px-6 rounded-xl transition-all shadow-lg whitespace-nowrap"
                >
                    <span class="text-yellow-500 shrink-0">★★★★★</span>
                    Deixar Avaliação
                </a>
            </div>
        </div>

    </div>
</section>