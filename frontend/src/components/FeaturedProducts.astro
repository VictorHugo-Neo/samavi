---
import { pool } from '../lib/db.js';

let produtos = [];
try {
    const consultaProdutos = await pool.query('SELECT * FROM admin_user.produtos ORDER BY criado_em DESC');
    produtos = consultaProdutos.rows;
} catch (erro) {
    console.error("Erro ao buscar produtos na vitrine:", erro);
}
---

<section id="destaques" class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
            <div class="max-w-2xl">
                <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
                    Destaques da Semana
                </h2>
                <p class="text-gray-600 text-lg">
                    Peças selecionadas a dedo para trazer conforto e sofisticação ao seu espaço.
                </p>
            </div>
            <a href="https://wa.me/5533988774411?text=Ol%C3%A1!%20Vim%20pelo%20site%20e%20gostaria%20de%20atendimento." class="hidden md:inline-flex items-center font-semibold text-red-700 hover:text-red-800 transition-colors">
                Ver todo o catálogo <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
        </div>

        <div class="flex overflow-x-auto pb-8 -mx-4 px-4 sm:mx-0 sm:px-0 md:grid md:grid-cols-2 lg:grid-cols-4 gap-6 md:overflow-visible snap-x snap-mandatory hide-scrollbar">
            
            {produtos.length === 0 ? (
                <div class="col-span-full py-16 flex flex-col items-center justify-center bg-white rounded-2xl border border-dashed border-gray-300 shadow-sm">
                    <svg class="w-16 h-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                    <p class="text-center text-gray-500 text-lg font-medium">Novos produtos serão adicionados em breve!</p>
                </div>
            ) : (
                produtos.map((produto: any) => (
                    <div class="snap-start shrink-0 w-[85vw] sm:w-[320px] md:w-auto md:shrink group relative bg-white rounded-2xl border border-gray-100 shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_8px_30px_rgb(0,0,0,0.12)] transition-all duration-300 flex flex-col overflow-hidden">
                        
                        <div class="relative h-64 overflow-hidden bg-gray-100">
                            <span class="absolute top-4 left-4 z-10 bg-black/80 backdrop-blur-md text-white text-xs font-bold px-3 py-1.5 rounded-md uppercase tracking-wider shadow-md">
                                Destaque
                            </span>

                            {produto.foto ? (
                                <img 
                                    src={`${import.meta.env.PUBLIC_ADMIN_URL}/uploads/${produto.foto}`} 
                                    alt={produto.nome} 
                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                                    loading="lazy"
                                />
                            ) : (
                                <div class="w-full h-full flex flex-col items-center justify-center text-gray-400 bg-gray-50">
                                    <svg class="w-12 h-12 mb-2 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    <span class="text-sm font-medium">Sem imagem</span>
                                </div>
                            )}
                        </div>

                        <div class="p-6 flex flex-col grow">
                            <span class="text-xs font-semibold text-red-700 uppercase tracking-wider mb-2">
                                Samavi Móveis
                            </span>
                            <h3 class="text-lg font-bold text-gray-900 mb-2 leading-snug line-clamp-2">
                                {produto.nome}
                            </h3>
                            <p class="text-gray-500 text-sm mb-6 line-clamp-2 grow">
                                {produto.descricao}
                            </p>
                            
                            <div class="mt-auto pt-4 border-t border-gray-50">
                                <a 
                                    href={`https://wa.me/5533988774411?text=${encodeURIComponent(produto.mensagem_whatsapp || `Olá! Vim pelo site e gostaria de saber mais sobre o produto: ${produto.nome}`)}`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="w-full inline-flex justify-center items-center gap-2 bg-gray-50 hover:bg-red-700 hover:text-white text-gray-800 font-semibold py-3 px-4 rounded-xl transition-colors duration-300 group/btn"
                                >
                                    <svg class="w-5 h-5 text-green-500 group-hover/btn:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                                    </svg>
                                    Consultar Condições
                                </a>
                            </div>
                        </div>
                        
                    </div>
                ))
            )}
        </div>
    </div>
</section>

<style>
.hide-scrollbar::-webkit-scrollbar {
    display: none;
}
.hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
}
</style>