---
// src/components/About.astro
---

<section class="py-20 bg-white" id="sobre">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div>
                <span
                    class="text-red-700 font-bold tracking-wider uppercase text-sm mb-2 block"
                >
                    Conheça a Nossa Loja
                </span>
                <h2
                    class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 leading-tight"
                >
                    A sua casa merece o melhor de <span class="text-red-700"
                        >Araçuaí</span
                    >
                </h2>
                <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                    Na <strong>Samavi Comercial</strong>, acreditamos que o seu
                    lar é o seu refúgio. É por isso que nos dedicamos a trazer
                    as melhores opções em <strong
                        >móveis, colchões e decoração</strong
                    > para transformar os seus espaços com conforto e sofisticação.
                </p>

                <div class="space-y-5 mt-8">
                    <div class="flex items-start">
                        <div class="shrink-0 h-6 w-6 text-red-700 mt-1">
                            <svg
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <div class="ml-4">
                            <h4 class="text-lg font-bold text-gray-900">
                                Qualidade Comprovada
                            </h4>
                            <p class="text-gray-600">
                                Peças selecionadas a dedo para garantir
                                durabilidade e design no seu dia a dia.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="shrink-0 h-6 w-6 text-red-700 mt-1">
                            <svg
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <div class="ml-4">
                            <h4 class="text-lg font-bold text-gray-900">
                                Atendimento Humanizado
                            </h4>
                            <p class="text-gray-600">
                                Uma equipa sempre pronta a ajudar a encontrar a
                                solução perfeita para a sua necessidade.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="shrink-0 h-6 w-6 text-red-700 mt-1">
                            <svg
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <div class="ml-4">
                            <h4 class="text-lg font-bold text-gray-900">
                                Tradição em Araçuaí
                            </h4>
                            <p class="text-gray-600">
                                Visite a nossa loja física na R. Dom Serafim, 16
                                - Centro e sinta-se em casa.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div
                class="relative h-125 rounded-2xl overflow-hidden shadow-2xl bg-gray-100 flex items-center justify-center group"
            >
                <div
                    class="absolute inset-0 bg-red-700 opacity-5 group-hover:opacity-10 transition-opacity duration-300"
                >
                </div>
                <div
                    class="relative h-125 rounded-2xl overflow-hidden shadow-2xl group"
                >
                    <img
                        src="fachada.png"
                        alt="Interior da Loja Samavi Comercial em Araçuaí"
                        class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                    />
                    <div
                        class="absolute inset-0 bg-red-700 opacity-0 group-hover:opacity-10 transition-opacity duration-300 pointer-events-none"
                    >
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
