---
import { pool } from "../lib/db.js";

let eventos = [];

try {
    const consulta = await pool.query(
        "SELECT * FROM admin_user.lives ORDER BY data_evento DESC",
    );
    eventos = consulta.rows;
} catch (erro) {
    console.error("Erro ao procurar eventos:", erro);
}

const formatarData = (dataSQL: string | Date) => {
    if (!dataSQL) return "";
    const data = new Date(dataSQL);
    return data.toLocaleDateString("pt-BR", { timeZone: "UTC" });
};

const hoje = new Date();
hoje.setHours(0, 0, 0, 0);

const proximasLives = eventos
    .filter((e: any) => new Date(e.data_evento) >= hoje)
    .sort(
        (a: any, b: any) =>
            new Date(a.data_evento).getTime() -
            new Date(b.data_evento).getTime(),
    );

const historico = eventos.filter((e: any) => new Date(e.data_evento) < hoje);
const proximaLive = proximasLives.length > 0 ? proximasLives[0] : null;
---

<section class="py-16 bg-gray-50" id="eventos">
    <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-gray-800 text-center mb-12">
            Nossos Eventos e Lives
        </h2>

        {
            proximaLive ? (
                <div class="bg-red-700 rounded-2xl shadow-xl overflow-hidden mb-16 flex flex-col md:flex-row text-white">
                    <div class="md:w-1/2 bg-red-800">
                        {proximaLive.foto ? (
                            <img
                                src={`http://localhost:4322/uploads/${proximaLive.foto}`}
                                alt={proximaLive.titulo}
                                class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity"
                            />
                        ) : (
                            <div class="w-full h-full min-h-75 flex items-center justify-center bg-red-900 text-red-300 font-medium">
                                Sem imagem de capa
                            </div>
                        )}
                    </div>
                    <div class="md:w-1/2 p-8 md:p-12 flex flex-col justify-center">
                        <span class="inline-block px-4 py-1 bg-white text-red-700 font-bold text-sm rounded-full w-max mb-4">
                            Próxima Live
                        </span>
                        <h3 class="text-3xl font-bold mb-2">
                            {proximaLive.titulo}
                        </h3>
                        <p class="text-xl font-semibold mb-4 text-red-100 flex items-center gap-2">
                            📅 {formatarData(proximaLive.data_evento)}
                            {proximaLive.hora_evento
                                ? `⏰ às ${proximaLive.hora_evento.substring(0, 5)}`
                                : ""}
                        </p>
                        <p class="mb-8 text-red-50 text-lg leading-relaxed">
                            {proximaLive.descricao}
                        </p>

                        {proximaLive.link_video && (
                            <a
                                href={proximaLive.link_video}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="bg-white text-red-700 hover:bg-gray-100 font-bold py-3 px-8 rounded-lg text-center transition-colors shadow-md"
                            >
                                Assistir / Definir Lembrete
                            </a>
                        )}
                    </div>
                </div>
            ) : (
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 text-center mb-16">
                    <p class="text-gray-500 text-lg">
                        Nenhuma live programada para os próximos dias. Fique de
                        olho nas nossas redes sociais!
                    </p>
                </div>
            )
        }

        <h3 class="text-2xl font-bold text-gray-800 mb-8 border-b pb-2">
            Histórico da Loja
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                historico.length === 0 ? (
                    <p class="text-gray-500 col-span-full">
                        Ainda não temos eventos passados registados.
                    </p>
                ) : (
                    historico.map((evento: any) => (
                        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow flex flex-col">
                            <div class="h-48 bg-gray-200 overflow-hidden">
                                {evento.foto ? (
                                    <img
                                        src={`${import.meta.env.PUBLIC_ADMIN_URL}/uploads/${evento.foto}`} 
                                        alt={evento.titulo}
                                        class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                                    />
                                ) : (
                                    <div class="w-full h-full flex items-center justify-center text-gray-400">
                                        Sem foto
                                    </div>
                                )}
                            </div>
                            <div class="p-6 flex-1 flex flex-col">
                                <h4 class="font-bold text-lg text-gray-800 mb-1">
                                    {evento.titulo}
                                </h4>
                                <p class="text-sm font-semibold text-red-600 mb-3">
                                    {formatarData(evento.data_evento)}
                                </p>
                                <p class="text-gray-600 text-sm line-clamp-3 mb-4 flex-1">
                                    {evento.descricao}
                                </p>

                                {evento.link_video && (
                                    <a
                                        href={evento.link_video}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-red-600 font-medium hover:underline text-sm flex items-center gap-1 w-max"
                                    >
                                        Ver evento gravado{" "}
                                        <span aria-hidden="true">&rarr;</span>
                                    </a>
                                )}
                            </div>
                        </div>
                    ))
                )
            }
        </div>
    </div>
</section>
