---
import { pool } from "../lib/db.js";

let eventos = [];

try {
    const consultaLives = await pool.query('SELECT * FROM admin_user.lives ORDER BY data_evento DESC');
    eventos = consultaLives.rows;
} catch (erro) {
    console.error("Erro ao procurar eventos:", erro);
}

const formatarData = (dataSQL: string | Date) => {
    if (!dataSQL) return "";
    const data = new Date(dataSQL);
    return data.toLocaleDateString("pt-BR", { timeZone: "UTC" });
};

const hoje = new Date();
hoje.setHours(0, 0, 0, 0);

const proximasLives = eventos
    .filter((e: any) => new Date(e.data_evento) >= hoje)
    .sort(
        (a: any, b: any) =>
            new Date(a.data_evento).getTime() -
            new Date(b.data_evento).getTime(),
    );

const historico = eventos.filter((e: any) => new Date(e.data_evento) < hoje);
const proximaLive = proximasLives.length > 0 ? proximasLives[0] : null;
---

<section class="py-16 sm:py-24 bg-gray-50" id="eventos">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        {/* Cabeçalho da Secção */}
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
            <span class="inline-block text-red-700 font-bold tracking-wider uppercase text-sm mb-2">
                Acontece na Samavi
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4 tracking-tight">
                Eventos e Lives no Instagram
            </h2>
            <p class="text-base sm:text-lg text-gray-600">
                Fique por dentro dos nossos lançamentos, ofertas relâmpago e dicas de decoração ao vivo.
            </p>
        </div>

        {/* Destaque: Próxima Live (Urgência e Contraste) */}
        {
            proximaLive ? (
                <div class="bg-gray-900 rounded-3xl shadow-2xl overflow-hidden mb-20 flex flex-col lg:flex-row relative group">
                    {/* Efeito de brilho de fundo */}
                    <div class="absolute inset-0 bg-gradient-to-r from-red-900/20 to-transparent pointer-events-none"></div>
                    
                    <div class="lg:w-1/2 relative h-64 sm:h-80 lg:h-auto overflow-hidden bg-gray-800">
                        {proximaLive.foto ? (
                            <img
                                src={`${import.meta.env.PUBLIC_ADMIN_URL}/uploads/${proximaLive.foto}`}
                                alt={proximaLive.titulo}
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-90"
                            />
                        ) : (
                            <div class="w-full h-full flex flex-col items-center justify-center text-gray-500 bg-gray-800">
                                <svg class="w-16 h-16 mb-2 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                <span>Imagem do Evento</span>
                            </div>
                        )}
                        <div class="absolute inset-0 bg-gradient-to-t from-gray-900 lg:hidden"></div>
                    </div>

                    <div class="lg:w-1/2 p-6 sm:p-10 lg:p-16 flex flex-col justify-center relative z-10 -mt-10 lg:mt-0">
                        <div class="flex items-center gap-3 mb-6">
                            <span class="flex items-center gap-2 px-3 py-1 bg-red-600/20 border border-red-500/30 text-red-400 font-bold text-xs sm:text-sm rounded-full uppercase tracking-wider">
                                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                                Próxima Live
                            </span>
                        </div>
                        
                        <h3 class="text-3xl sm:text-4xl font-bold text-white mb-4 leading-tight">
                            {proximaLive.titulo}
                        </h3>
                        
                        {/* Box de Data/Hora (Ticket Design) */}
                        <div class="flex items-center gap-4 bg-gray-800/50 border border-gray-700 rounded-2xl p-4 mb-6 w-max backdrop-blur-sm">
                            <div class="bg-gray-700 rounded-xl p-3 text-center min-w-[70px]">
                                <span class="block text-red-400 text-xs font-bold uppercase mb-1">Data</span>
                                <span class="block text-white font-bold text-lg leading-none">{formatarData(proximaLive.data_evento).substring(0, 5)}</span>
                            </div>
                            {proximaLive.hora_evento && (
                                <div class="bg-gray-700 rounded-xl p-3 text-center min-w-[70px]">
                                    <span class="block text-red-400 text-xs font-bold uppercase mb-1">Hora</span>
                                    <span class="block text-white font-bold text-lg leading-none">{proximaLive.hora_evento.substring(0, 5)}</span>
                                </div>
                            )}
                        </div>

                        <p class="mb-8 text-gray-300 text-base sm:text-lg leading-relaxed line-clamp-3">
                            {proximaLive.descricao}
                        </p>

                        {proximaLive.link_video && (
                            <a
                                href={proximaLive.link_video}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex justify-center items-center gap-3 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 shadow-[0_0_20px_rgb(220,38,38,0.3)] hover:shadow-[0_0_30px_rgb(220,38,38,0.5)] hover:-translate-y-1 w-full sm:w-auto"
                            >
                                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                                Ativar Lembrete no Instagram
                            </a>
                        )}
                    </div>
                </div>
            ) : (
                /* Estado Vazio Otimizado para Captura de Leads (Instagram) */
                <div class="bg-white rounded-3xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] border border-gray-100 p-8 sm:p-12 text-center mb-20 max-w-3xl mx-auto">
                    <div class="w-16 h-16 bg-gray-50 text-gray-900 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-3">Nenhuma live no momento</h3>
                    <p class="text-gray-600 text-lg mb-8">
                        Estamos a preparar um evento muito especial. Siga-nos no Instagram para ser o primeiro a saber das nossas próximas transmissões e ofertas!
                    </p>
                    <a href="https://instagram.com/samavicomercial" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center gap-2 bg-gray-900 hover:bg-gray-800 text-white font-bold py-3 px-8 rounded-xl transition-all">
                        Seguir @samavicomercial
                    </a>
                </div>
            )
        }

        {/* Secção Histórico */}
        <div class="flex items-center justify-between mb-8 border-b border-gray-200 pb-4">
            <h3 class="text-2xl font-bold text-gray-900">
                Eventos Passados
            </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                historico.length === 0 ? (
                    <p class="text-gray-500 col-span-full bg-white p-6 rounded-xl border border-gray-100 text-center">
                        O histórico de eventos aparecerá aqui.
                    </p>
                ) : (
                    historico.map((evento: any) => (
                        <div class="bg-white rounded-2xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] border border-gray-100 overflow-hidden hover:-translate-y-1 hover:shadow-lg transition-all duration-300 flex flex-col group">
                            
                            {/* Imagem do Histórico */}
                            <div class="relative h-52 bg-gray-100 overflow-hidden">
                                <div class="absolute top-4 left-4 z-10 bg-white/90 backdrop-blur text-gray-900 text-xs font-bold px-3 py-1 rounded-md shadow-sm">
                                    {formatarData(evento.data_evento)}
                                </div>
                                {evento.foto ? (
                                    <img
                                        src={`${import.meta.env.PUBLIC_ADMIN_URL}/uploads/${evento.foto}`} 
                                        alt={evento.titulo}
                                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                    />
                                ) : (
                                    <div class="w-full h-full flex items-center justify-center text-gray-400 bg-gray-50">
                                        <svg class="w-10 h-10 opacity-30" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                                    </div>
                                )}
                                {/* Overlay escuro sutil ao passar o mouse com ícone do Instagram */}
                                <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                                    {evento.link_video && (
                                        <div class="bg-gray-900 text-white p-3 rounded-full transform translate-y-4 group-hover:translate-y-0 transition-all duration-300 shadow-xl">
                                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                                        </div>
                                    )}
                                </div>
                            </div>

                            {/* Conteúdo do Histórico */}
                            <div class="p-6 flex-1 flex flex-col">
                                <h4 class="font-bold text-xl text-gray-900 mb-3 line-clamp-2 group-hover:text-red-700 transition-colors">
                                    {evento.titulo}
                                </h4>
                                <p class="text-gray-600 text-sm line-clamp-3 mb-6 flex-1 leading-relaxed">
                                    {evento.descricao}
                                </p>

                                {evento.link_video ? (
                                    <a
                                        href={evento.link_video}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="mt-auto w-full inline-flex justify-center items-center gap-2 bg-gray-50 hover:bg-gray-100 text-gray-900 font-semibold py-3 px-4 rounded-xl transition-colors duration-300 border border-gray-200"
                                    >
                                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                                        Ver no Instagram
                                    </a>
                                ) : (
                                    <span class="mt-auto block text-center text-sm text-gray-400 py-3">
                                        Post indisponível
                                    </span>
                                )}
                            </div>
                        </div>
                    ))
                )
            }
        </div>
    </div>
</section>