---
const pathname = Astro.url.pathname;
---

<div
    class="flex justify-between items-center bg-white p-4 rounded-lg shadow-sm border border-gray-100 mb-6"
>
    <div class="flex flex-col sm:flex-row sm:gap-6 sm:items-center gap-4">
        <h1 class="text-2xl font-bold text-gray-800 sm:border-r sm:pr-6">
            Painel Samavi
        </h1>

        <div class="flex gap-4">
            <a
                href="/dashboard"
                class={`font-medium transition-colors ${pathname === "/dashboard" ? "text-red-600 font-bold border-b-2 border-red-600 pb-1" : "text-gray-500 hover:text-red-600"}`}
            >
                Produtos
            </a>
            <a
                href="/lives"
                class={`font-medium transition-colors ${pathname === "/lives" ? "text-red-600 font-bold border-b-2 border-red-600 pb-1" : "text-gray-500 hover:text-red-600"}`}
            >
                Lives e Eventos
            </a>
        </div>
    </div>
    <a href="/logout" class="text-red-600 font-semibold hover:underline">Sair</a>
</div>
